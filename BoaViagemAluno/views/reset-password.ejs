<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nova Palavra-passe — Boa Viagem</title>
    <link rel="icon" href="/boaviagem.svg" type="image/x-icon">
    <link rel="stylesheet" href="/style.css">
</head>
<body class="auth-body">
    <div class="auth-shell">
        <div class="auth-card">
            <div style="text-align: center; margin-bottom: 24px;">
                <div style="display: flex; justify-content: center; margin-bottom: 12px;">
                    <div class="brand-mark" style="width: 58px; height: 58px;" aria-label="Boa Viagem"></div>
                </div>
                <h2 style="color: var(--brand-purple); font-weight: 800; margin-bottom: 4px;">Nova Palavra-passe</h2>
            </div>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="inline-alert inline-alert-warning" style="margin-bottom: 16px;" role="alert">
                    <%= error %>
                    <% if (!token) { %> <br><a href="/recuperar-password">Pedir novo link</a> <% } %>
                </div>
            <% } %>

            <% if (token) { %>
                <form action="/recuperar-password/<%= token %>" method="POST" class="auth-form">
                    <div class="form-field">
                        <label for="password">Nova palavra-passe</label>
                        <input id="password" type="password" name="password" autocomplete="new-password" minlength="8" required>
                    </div>
                    <div class="form-field">
                        <label for="confirmarPassword">Confirmar palavra-passe</label>
                        <input id="confirmarPassword" type="password" name="confirmarPassword" autocomplete="new-password" minlength="8" required>
                    </div>
                    <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 10px;">
                        Guardar nova palavra-passe
                    </button>
                </form>
            <% } %>
        </div>
    </div>
</body>
</html>