<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Recuperar Palavra-passe — Boa Viagem</title>
    <link rel="icon" href="/boaviagem.svg" type="image/x-icon">
    <link rel="stylesheet" href="/style.css">
</head>
<body class="auth-body">
    <div class="auth-shell">
        <div class="auth-card">
            <div style="text-align: center; margin-bottom: 24px;">
                <div style="display: flex; justify-content: center; margin-bottom: 12px;">
                    <div class="brand-mark" style="width: 58px; height: 58px;" aria-label="Boa Viagem"></div>
                </div>
                <h2 style="color: var(--brand-purple); font-weight: 800; margin-bottom: 4px;">Recuperar Palavra-passe</h2>
                <p class="muted">Indique o seu email para receber um link de recuperação</p>
            </div>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="inline-alert inline-alert-warning" style="margin-bottom: 16px;" role="alert"><%= error %></div>
            <% } %>
            <% if (typeof sucesso !== 'undefined' && sucesso) { %>
                <div class="inline-alert inline-alert-success" style="margin-bottom: 16px;" role="status"><%= sucesso %></div>
            <% } %>

            <form action="/recuperar-password" method="POST" class="auth-form">
                <div class="form-field">
                    <label for="username">Email</label>
                    <input id="username" type="text" name="username" placeholder="aluno@boaviagem.pt" autocomplete="username" required autofocus>
                </div>
                <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 10px;">
                    Enviar link de recuperação
                </button>
            </form>
            <p class="muted" style="text-align:center; margin-top: 16px; font-size: 0.85rem;">
                <a href="/login">Voltar ao login</a>
            </p>
        </div>
    </div>
</body>
</html>